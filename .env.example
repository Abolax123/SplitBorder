# SplitBorder Environment Config
PORT=4001
NODE_ENV=development

# Blaaiz Sandbox API Configuration
# Get credentials from https://business-dev.blaaiz.com (Developer -> API Keys)
BLAAIZ_API_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
BLAAIZ_API_KEY=

# Set to true to force deterministic mock responses even if credentials exist
MOCK_MODE=false
