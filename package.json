{
  "name": "splitborder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node init && concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node init && tsx watch server/src/index.ts",
    "dev:client": "node init && vite --port 5174 --host 0.0.0.0",
    "build": "node init && tsc -p client/tsconfig.json && vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
